{
  "name": "remindme",
  "version": "1.4.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "setup": "npx expo install react react-native expo-notifications @react-native-async-storage/async-storage react-native-safe-area-context @expo/vector-icons expo-linear-gradient expo-haptics expo-font @expo-google-fonts/rubik react-native-android-widget expo-blur",
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android:apk": "eas build -p android --profile preview",
    "ios:testflight": "eas build -p ios --profile production --auto-submit"
  },
  "dependencies": {
    "@expo-google-fonts/rubik": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.0",
    "expo-blur": "~58.0.5",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-notifications": "~58.1.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-android-widget": "^0.24.0",
    "react-native-safe-area-context": "~5.10.1"
  }
}
